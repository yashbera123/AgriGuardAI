# AgriGuardAI - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# Google Gemini API Key (Primary AI)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Llama API Key (Fallback AI)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
# If running with Docker Compose, DB_HOST should remain 'mysql'
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=agriguard

# Model Configuration
MODEL_PATH=model/tomato_disease_model.keras
